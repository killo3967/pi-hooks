{
  "name": "@killo3967/pi-hooks",
  "version": "0.1.1",
  "description": "Claude Code-compatible command hooks for the Pi coding agent (maintained fork)",
  "author": "killo3967",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "hooks",
    "command-hooks",
    "claude-code",
    "claude-code-hooks"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killo3967/pi-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/killo3967/pi-hooks/issues"
  },
  "homepage": "https://github.com/killo3967/pi-hooks#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/pi-hooks.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  }
}
